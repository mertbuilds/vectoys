{
  "name": "vectoys",
  "main": "./worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/op/*"]
  },
  "routes": [
    { "pattern": "vectoys.com", "custom_domain": true },
    { "pattern": "www.vectoys.com", "custom_domain": true }
  ]
}
